{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
  {{- range .Data.Pages }}
  {{- $isThinTag := and (or (eq .Kind "term") (eq .Kind "taxonomy")) (eq .Data.Singular "tag") }}
  {{- $isNoindexSection := and (eq .Kind "section") (in (slice "pages" "landing" "sections") .Section) }}
  {{- $isNoindexRobots := in (lower (or .Params.robots "")) "noindex" }}
  {{- if and (not .Params.noindex) (not $isNoindexRobots) .Permalink (not $isThinTag) (not $isNoindexSection) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
    {{- $page := . -}}
    {{- $mapImg := $page.Params.image | default $page.Params.hero_image -}}
    {{- with $mapImg }}
    <image:image>
      <image:loc>{{ . | absURL }}</image:loc>
      <image:title>{{ $page.Title }}</image:title>
    </image:image>
    {{- end }}
    {{- if .IsHome }}
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    {{- else if eq .Section "services" }}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
    {{- else if eq .Section "blog" }}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    {{- else if eq .Section "case-studies" }}
    <changefreq>monthly</changefreq>
    <priority>0.72</priority>
    {{- else if eq .Section "industries" }}
    <changefreq>monthly</changefreq>
    <priority>0.75</priority>
    {{- else if eq .Section "locations" }}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    {{- else if eq .RelPermalink "/contact/" }}
    <changefreq>monthly</changefreq>
    <priority>0.9</priority>
    {{- else if eq .RelPermalink "/about/" }}
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
    {{- else if eq .RelPermalink "/faq/" }}
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
    {{- else }}
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
    {{- end }}
  </url>
  {{- end }}
  {{- end }}
</urlset>
